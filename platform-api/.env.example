VG_ENVIRONMENT=development
VG_DATABASE_PATH=./data/platform.db
VG_RUNTIME_BASE_URL=http://127.0.0.1:8100
VG_RUNTIME_TIMEOUT_SECONDS=20
VG_CORS_ORIGINS=http://127.0.0.1:4373,http://localhost:4373

# Existing API-key/development authentication remains the automation and Live-write boundary.
# Never place raw production tokens in this file or source control.
VG_AUTH_MODE=development
VG_AUTH_CREDENTIALS_JSON=[]
VG_DEVELOPMENT_USER_ID=development-user
VG_DEVELOPMENT_ROLES=admin

# Optional Financial-AI gateway key digest. Leave empty to rely on platform session auth only.
# Generate SHA-256 outside the repository and configure only the 64-character digest here.
VG_FINANCIAL_AI_ACCESS_KEY_SHA256=

# Browser users use opaque server-side Sessions and same-origin /api/v1 requests.
VG_BROWSER_SESSIONS_ENABLED=true
VG_SESSION_COOKIE_NAME=vg_session
VG_SESSION_ABSOLUTE_TTL_MINUTES=720
VG_SESSION_IDLE_TTL_MINUTES=30
VG_SESSION_RECENT_REAUTH_MINUTES=10
VG_SESSION_LAST_SEEN_WRITE_MINUTES=5
VG_SESSION_MAX_ACTIVE_PER_USER=5
VG_PASSWORD_RESET_TICKET_TTL_MINUTES=30
VG_LOGIN_FAILURE_LIMIT=5
VG_LOGIN_LOCK_MINUTES=15

# Public auth limits are an application safeguard. Production proxy limits must be equal or stricter.
VG_PUBLIC_AUTH_RATE_WINDOW_SECONDS=60
VG_PUBLIC_LOGIN_RATE_LIMIT=20
VG_PUBLIC_REGISTRATION_RATE_LIMIT=5
VG_PUBLIC_PASSWORD_RESET_RATE_LIMIT=10
VG_PUBLIC_RATE_LIMIT_MAX_KEYS=10000

# Avatar files are application data outside the repository.
VG_AVATAR_DATA_DIRECTORY=./data/avatars
VG_AVATAR_MAX_BYTES=2097152
VG_AVATAR_MAX_PIXELS=20000000
VG_AVATAR_OUTPUT_SIZE=512

# Customer-reporting fund NAV becomes explicitly stale after this age.
VG_FUND_NAV_STALE_AFTER_HOURS=36

# Live execution is disabled by default; an explicit operator action enables normal trading.
VG_LIVE_TRADING_ENABLED=false
VG_DEFAULT_TRADING_ENVIRONMENT=simulation
VG_CROSS_SPREAD_EXIT_MONITOR_ENABLED=false
VG_CROSS_SPREAD_EXIT_MONITOR_INTERVAL_SECONDS=1

# Keep instruction-owned rollback and position verification protections.
VG_CROSS_SPREAD_DEFINITIVE_FAILURE_ROLLBACK_ENABLED=true
VG_CROSS_SPREAD_POSITION_VERIFICATION_REQUIRED=true
