# Variable-Global Execution Runtime live configuration template
# Copy to execution-runtime/.env only on the controlled live host.
# Never commit the real .env file or any API key, secret, password, or terminal credential.

VG_RUNTIME_ENVIRONMENT=live
VG_RUNTIME_GATEWAY_NAME=bybit_mt5
VG_RUNTIME_JOURNAL_PATH=./data/live_runtime_journal.db

# Two independent write gates remain closed during read-only and shadow stages.
VG_RUNTIME_LIVE_WRITE_ENABLED=false

# Keep allowlists empty until the exact Platform IDs and symbols are approved.
VG_RUNTIME_LIVE_ACCOUNT_ALLOWLIST=
VG_RUNTIME_LIVE_STRATEGY_ALLOWLIST=
VG_RUNTIME_LIVE_SYMBOL_ALLOWLIST=

# Zero means no live order can pass the notional gate.
# Set non-zero values only for the approved minimum-capital acceptance window.
VG_RUNTIME_LIVE_MAX_ORDER_NOTIONAL=0
VG_RUNTIME_LIVE_MAX_DAILY_NOTIONAL=0

# Temporary Issue #96 real-money acceptance limits.
# These values do not authorize writes and must only change through a separate review Issue/PR.
VG_RUNTIME_LIVE_ACCEPTANCE_MAX_ORDER_QUANTITY=1
VG_RUNTIME_LIVE_ACCEPTANCE_MAX_POSITIONS_PER_SYMBOL=1

# Credential references are identifiers only. Choose one explicit provider per reference:
# - secret://environment/<name>
# - secret://windows-credential-manager/<name>
# No secret value belongs in this file.
VG_RUNTIME_CREDENTIAL_REFS=secret://environment/bybit-live-001,secret://environment/mt5-live-001

# Bybit live account
VG_RUNTIME_BYBIT_CREDENTIAL_REF=secret://environment/bybit-live-001
VG_RUNTIME_BYBIT_ACCOUNT_IDS=
VG_RUNTIME_BYBIT_INSTRUMENT_MAP=
VG_RUNTIME_BYBIT_CATEGORY=linear
VG_RUNTIME_BYBIT_SETTLE_COIN=USDT
VG_RUNTIME_BYBIT_CONTRACT_SYMBOL=XAUTUSDT
VG_RUNTIME_BYBIT_DEMO_MODE=false
VG_RUNTIME_BYBIT_RECV_WINDOW=20000
VG_RUNTIME_BYBIT_CHECK_TIMEOUT_SECONDS=8
VG_RUNTIME_BYBIT_FILL_CONFIRMATION_TIMEOUT_SECONDS=5
VG_RUNTIME_BYBIT_FILL_CONFIRMATION_POLL_SECONDS=0.1

# MT5 live account
VG_RUNTIME_MT5_CREDENTIAL_REF=secret://environment/mt5-live-001
VG_RUNTIME_MT5_ACCOUNT_IDS=
VG_RUNTIME_MT5_INSTRUMENT_MAP=
VG_RUNTIME_MT5_SYMBOL=XAUUSD+
VG_RUNTIME_MT5_TERMINAL_PATH=
# Standard Windows hosts derive the bridge file from APPDATA automatically:
# %APPDATA%\MetaQuotes\Terminal\Common\Files\variable_global_mt5_bridge.json
# Uncomment only when the approved host uses a non-standard location.
# VG_RUNTIME_MT5_BRIDGE_FILE_PATH=D:\approved\mt5\variable_global_mt5_bridge.json
VG_RUNTIME_MT5_CHECK_TIMEOUT_SECONDS=5
VG_RUNTIME_MT5_MAGIC_NUMBER=5604001
VG_RUNTIME_MT5_DEVIATION_POINTS=20
VG_RUNTIME_MT5_HISTORY_LOOKBACK_DAYS=7

# Environment provider examples. Set these only on the controlled live host.
# VG_SECRET_BYBIT_LIVE_001_API_KEY=
# VG_SECRET_BYBIT_LIVE_001_SECRET=
# VG_SECRET_BYBIT_LIVE_001_VERSION=
# VG_SECRET_MT5_LIVE_001_LOGIN=
# VG_SECRET_MT5_LIVE_001_PASSWORD=
# VG_SECRET_MT5_LIVE_001_SERVER=
# VG_SECRET_MT5_LIVE_001_VERSION=

# Windows Credential Manager target convention:
# VariableGlobal/<secret-name>/<FIELD>
# Example targets:
# VariableGlobal/bybit-live-001/API_KEY
# VariableGlobal/bybit-live-001/SECRET
# VariableGlobal/bybit-live-001/VERSION
