#!/bin/sh
[ "${HUSKY:-1}" = "0" ] && exit 0

HUSKY_DIR="$(dirname "$0")"
if [ -f "$HUSKY_DIR/_/husky.sh" ]; then
  . "$HUSKY_DIR/_/husky.sh"
fi

if ! command -v corepack >/dev/null 2>&1; then
  echo "corepack is required to run platform-web commit-msg checks." >&2
  exit 1
fi

PATH="/usr/local/bin:$PATH"

commit_message_file="$(cd "$(dirname "$1")" && pwd)/$(basename "$1")"
cd "$(git rev-parse --show-toplevel)/platform-web"
corepack pnpm@9.15.9 exec commitlint --edit "$commit_message_file"
