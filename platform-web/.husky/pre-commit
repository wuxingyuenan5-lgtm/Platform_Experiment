#!/bin/sh
[ "${HUSKY:-1}" = "0" ] && exit 0

HUSKY_DIR="$(dirname "$0")"
if [ -f "$HUSKY_DIR/_/husky.sh" ]; then
  . "$HUSKY_DIR/_/husky.sh"
fi

. "$(dirname "$0")/common.sh"

[ -n "$CI" ] && exit 0

if ! command -v corepack >/dev/null 2>&1; then
  echo "corepack is required to run platform-web pre-commit checks." >&2
  exit 1
fi

PATH="/usr/local/bin:$PATH"

# Hooks run from the repository root while frontend tooling lives in platform-web.
cd "$(git rev-parse --show-toplevel)/platform-web"
corepack pnpm@9.15.9 exec lint-staged
