{
  "name": "vg-platform-web",
  "version": "0.9.3",
  "private": true,
  "description": "Platform research, trading, risk, identity, portfolio and reconciliation web application",
  "homepage": "https://github.com/wuxingyuenan5-lgtm/Platform_Experiment",
  "bugs": {
    "url": "https://github.com/wuxingyuenan5-lgtm/Platform_Experiment/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wuxingyuenan5-lgtm/Platform_Experiment.git"
  },
  "license": "MIT",
  "scripts": {
    "bootstrap": "pnpm install",
    "build": "pnpm sync:trading-tools && cross-env NODE_ENV=production NODE_OPTIONS=--max-old-space-size=8192 pnpm vite build && node scripts/verify-formal-brand-config.cjs",
    "build:analyze": "pnpm sync:trading-tools && cross-env NODE_OPTIONS=--max-old-space-size=8192 pnpm vite build --mode analyze",
    "build:docker": "pnpm sync:trading-tools && vite build --mode docker",
    "build:no-cache": "pnpm store prune && npm run build",
    "build:test": "pnpm sync:trading-tools && cross-env NODE_OPTIONS=--max-old-space-size=8192 pnpm vite build --mode test",
    "commit": "czg",
    "dev": "pnpm sync:trading-tools && pnpm vite",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "turbo run stub",
    "lint": "turbo run lint",
    "lint:eslint": "eslint --cache --max-warnings 0  \"{src,mock}/**/*.{vue,ts,tsx}\" --fix",
    "lint:prettier": "prettier --write .",
    "lint:stylelint": "stylelint \"**/*.{vue,css,less,scss}\" --fix --cache --cache-location node_modules/.cache/stylelint/",
    "prepare": "husky install",
    "preview": "npm run build && vite preview",
    "reinstall": "rimraf pnpm-lock.yaml && rimraf package.lock.json && rimraf node_modules && npm run bootstrap",
    "serve": "npm run dev",
    "sync:trading-tools": "node scripts/sync-trading-tools-from-md.cjs",
    "test:cross-spread-layout": "node scripts/verify-cross-spread-layout.cjs",
    "test:e2e:hedge-board": "playwright test -c playwright.hedge-board.config.ts",
    "test:e2e:platform-visual": "playwright test -c playwright.platform-visual.config.ts",
    "test:e2e:user-system": "playwright test -c playwright.user-system.config.ts",
    "test:funding-order-layout": "node scripts/verify-funding-order-layout.cjs",
    "test:gzip": "npx http-server dist --cors --gzip -c-1",
    "test:hedge-board-layout": "node scripts/verify-hedge-board-layout.cjs",
    "test:homepage-layout": "node scripts/verify-homepage-layout.cjs",
    "test:user-system": "node scripts/test-user-system-access.cjs",
    "type:check": "vue-tsc -p tsconfig.strategy.json --noEmit --skipLibCheck",
    "type:check:full": "vue-tsc -p tsconfig.full.json --noEmit --skipLibCheck"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "{!(package)*.json,*.code-snippets,.!(browserslist)*rc}": [
      "prettier --write--parser json"
    ],
    "package.json": [
      "prettier --write"
    ],
    "*.vue": [
      "prettier --write",
      "eslint --fix",
      "stylelint --fix"
    ],
    "*.{scss,less,styl,html}": [
      "prettier --write",
      "stylelint --fix"
    ],
    "*.md": [
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "dependencies": {
    "@ant-design/icons-vue": "^6.1.0",
    "@iconify/iconify": "^3.1.1",
    "@logicflow/core": "^1.2.9",
    "@logicflow/extension": "^1.2.9",
    "@vben/hooks": "workspace:*",
    "@vue/shared": "^3.3.4",
    "@vueuse/core": "^10.2.1",
    "@vueuse/shared": "^10.2.1",
    "@zxcvbn-ts/core": "^3.0.2",
    "ant-design-vue": "^4.0.6",
    "axios": "^1.4.0",
    "codemirror": "^5.65.12",
    "cropperjs": "^1.5.13",
    "crypto-js": "^4.1.1",
    "dayjs": "^1.11.10",
    "decimal.js": "^10.4.3",
    "driver.js": "^1.3.0",
    "echarts": "^5.4.2",
    "exceljs": "^4.3.0",
    "lodash-es": "^4.17.21",
    "nprogress": "^0.2.0",
    "path-to-regexp": "^6.2.1",
    "pinia": "2.1.4",
    "pinia-plugin-persistedstate": "^3.2.0",
    "print-js": "^1.6.0",
    "qrcode": "^1.5.3",
    "qs": "^6.11.2",
    "resize-observer-polyfill": "^1.5.1",
    "showdown": "^2.1.0",
    "sortablejs": "^1.15.0",
    "tinymce": "^5.10.7",
    "unocss": "0.53.4",
    "vditor": "^3.9.4",
    "vue": "^3.3.4",
    "vue-i18n": "^9.6.4",
    "vue-json-pretty": "^2.2.4",
    "vue-router": "^4.2.3",
    "vue-types": "^5.1.0",
    "vuedraggable": "^4.1.0",
    "vxe-table": "^4.4.5",
    "vxe-table-plugin-export-xlsx": "^3.0.4",
    "xe-utils": "^3.5.11",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.6.6",
    "@commitlint/config-conventional": "^17.6.6",
    "@iconify/json": "^2.2.87",
    "@microsoft/api-extractor": "^7.58.7",
    "@playwright/test": "^1.62.0",
    "@purge-icons/generated": "^0.9.0",
    "@types/codemirror": "^5.60.8",
    "@types/crypto-js": "^4.1.1",
    "@types/lodash-es": "^4.17.7",
    "@types/nprogress": "^0.2.0",
    "@types/qrcode": "^1.5.1",
    "@types/qs": "^6.9.7",
    "@types/showdown": "^2.0.1",
    "@types/sortablejs": "^1.15.1",
    "@vben/eslint-config": "workspace:*",
    "@vben/stylelint-config": "workspace:*",
    "@vben/ts-config": "workspace:*",
    "@vben/types": "workspace:*",
    "@vben/vite-config": "workspace:*",
    "@vue/compiler-sfc": "^3.3.4",
    "@vue/test-utils": "^2.4.0",
    "cross-env": "^7.0.3",
    "cz-git": "^1.6.1",
    "czg": "^1.6.1",
    "husky": "^8.0.3",
    "lint-staged": "13.2.3",
    "prettier": "^2.8.8",
    "prettier-plugin-packagejson": "^2.4.6",
    "rimraf": "^5.0.1",
    "turbo": "^1.10.7",
    "typescript": "^5.2.2",
    "unbuild": "^1.2.1",
    "vite": "^4.4.0",
    "vue-tsc": "^1.8.4"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=16.15.1",
    "pnpm": ">=9.0.0 <10"
  }
}
