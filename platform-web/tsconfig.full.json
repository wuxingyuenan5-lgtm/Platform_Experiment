{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": [
    "internal/**/*.ts",
    "src/api/hedgeResearch.ts",
    "src/api/platform/**/*.ts",
    "src/api/riskControl.ts",
    "src/api/sys/accountDirectory.ts",
    "src/api/sys/errorLog.ts",
    "src/components/Loading/**/*.vue",
    "src/components/ProductDataState/**/*.vue",
    "src/components/SimpleMenu/**/*.ts",
    "src/components/SimpleMenu/**/*.vue",
    "src/design/**/*.d.ts",
    "src/design/**/*.ts",
    "src/design/**/*.vue",
    "src/hooks/web/useECharts.ts",
    "src/layouts/default/menu/**/*.vue",
    "src/router/helper/routeHelper.ts",
    "src/router/routes/modules/hedge.ts",
    "src/router/types.ts",
    "src/router/viewRegistry.generated.ts",
    "src/views/audit/**/*.vue",
    "src/views/dashboard/**/*.ts",
    "src/views/dashboard/**/*.vue",
    "src/views/data/**/*.vue",
    "src/views/finance/**/*.vue",
    "src/views/financialAi/**/*.vue",
    "src/views/hedgeBoard/**/*.ts",
    "src/views/hedgeBoard/**/*.vue",
    "src/views/landing/**/*.ts",
    "src/views/landing/**/*.vue",
    "src/views/log/operate/data.tsx",
    "src/views/log/operate/index.vue",
    "src/views/monitor/**/*.vue",
    "src/views/newsCalendar/**/*.ts",
    "src/views/newsCalendar/**/*.vue",
    "src/views/notification/**/*.vue",
    "src/views/platform/**/*.ts",
    "src/views/platform/**/*.vue",
    "src/views/reports/**/*.vue",
    "src/views/risk/detail/**/*.vue",
    "src/views/risk/profile/index.vue",
    "src/views/risk/profile/security/modules.tsx",
    "src/views/settings/**/*.vue",
    "src/views/strategy/**/*.ts",
    "src/views/strategy/**/*.vue",
    "src/views/sys/error-log/index.vue",
    "types/**/*.d.ts",
    "types/**/*.ts",
    "vite.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.js",
    "src/store/modules/multipleTab.ts",
    "src/store/modules/permission.ts",
    "src/store/modules/user.ts",
    "src/utils/http/axios/axiosRetry.ts"
  ]
}
